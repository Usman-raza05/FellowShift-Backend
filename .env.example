# Required for every API route other than GET /
FELLOWSHIFT_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Configure at least one provider. Mistral is tried first when configured.
MISTRAL_API_KEY=
GEMINI_API_KEY=
MISTRAL_MODEL=pixtral-12b-2409
GEMINI_MODEL=gemini-3.5-flash

# Per-provider HTTP timeout is additionally bounded to fit a fallback attempt
AI_PROVIDER_TIMEOUT_SECONDS=25
AI_REQUEST_TIMEOUT_SECONDS=65

# Mount this path on persistent storage for idempotency across restarts.
IDEMPOTENCY_DB_PATH=.data/idempotency.sqlite3
